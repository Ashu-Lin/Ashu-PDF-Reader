{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ashu PDF Reader",
  "version": "0.1.3",
  "identifier": "com.ashu.pdfreader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ashu PDF Reader",
        "width": 1180,
        "height": 780,
        "minWidth": 320,
        "minHeight": 240,
        "decorations": false,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}




